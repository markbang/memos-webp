# 复制为 .env 后按需修改；不建 .env 时 compose 使用下方默认值。
# 注意：值不要加单引号（compose 会原样保留进环境变量）。

# 运行模式 / 端口
MEMOS_MODE=prod
MEMOS_PORT=5230

# 实例公网地址（公开 memo / CORS 需要）
MEMOS_INSTANCE_URL=https://s.bangwu.top

# fork 镜像（需要先自己构建推送，见 docker-compose.yml 顶部注释）
MEMOS_IMAGE=ghcr.io/markbang/memos-webp:0.31.0-webp

# 上传图片压缩参数（fork 特性）
MEMOS_IMAGE_MAX_DIMENSION=1920
MEMOS_IMAGE_WEBP_QUALITY=85
